  "natrium_korrigerat": {
    "namn": "Korrigerat natrium",
    "monster": "formel",
    "rubrik": "Korrigerat natrium vid högt glukos",
    "intro": "Ett högt P-glukos drar vatten ut ur cellerna och späder ut natriumet i blodet, så att uppmätt natrium ser lägre ut än kroppens faktiska saltbalans. Räknaren visar det korrigerade natriumet enligt två formler: Katz (1973), som länge var standard, och Hillier et al. (1999), som mätte upp att effekten är starkare än Katz uppskattade.",
    "kalla": "Katz (1973); Hillier, Abbott & Barrett (1999)",

    "falt": [
      {
