#!/usr/bin/env bash
# Quiz-regelgrind (CLAUDE_REGLER.md §2.9–2.11). Blockerar commit om en STAGEAD
# quiz-datafil bryter mot en maskinellt kontrollerbar regel.
# Kollar bara stageade data/*.json – gammal skuld i orörda filer blockerar inte.
# Kringgå medvetet vid behov med:  git commit --no-verify
#
# INSTALLATION: hooken ligger i .githooks/ och är inaktiv i en färsk klon tills
# `git config core.hooksPath .githooks` körts. Det görs numera av SessionStart-
# hooken i .claude/settings.json, så att spärren lever i webb-sessioner också.
# Kontrollera med:  git config core.hooksPath   (ska säga .githooks)
set -euo pipefail

stoppa() {
  echo ""
  echo "⛔ Commit stoppad: $1"
  shift
  for rad in "$@"; do echo "   $rad"; done
  echo "   Medvetet undantag: git commit --no-verify"
  exit 1
}

stageade=$(git diff --cached --name-only --diff-filter=ACM)

# --- Version + CHANGELOG för VARJE commit (SEO_REGLER §11 A, §12) -----------
# Kedjan i §11 A är avbockad först när versionen är satt med bump_version.py
# OCH CHANGELOG.md bär en post för just den versionen. §12 kör den avbockningen
# före commit — alltså gäller den varje commit, inte bara sidändringar.
#
# Den här grinden fanns tidigare bara som en versionssynk-kontroll, och den
# utlöstes av att VERSION/index.html/js/css var stageat. En commit som rör
# enbart scripts/ eller data/ passerade därför utan vare sig bump eller
# CHANGELOG-post. Det hände i 624dc74a (mätverktyget för breddtäckning), och
# felet var osynligt eftersom hooken dessutom var oinstallerad i klonen.
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  :   # merge-commit: kedjan hör till de commits som mergas, inte till mergen
else
  grep -qx 'VERSION' <<<"$stageade" || stoppa \
    "VERSION är inte bumpad (SEO_REGLER §11 A)." \
    "Bumpa aldrig för hand:" \
    "  python3 scripts/bump_version.py <version>"

  ver=$(git show :VERSION | tr -d '[:space:]')

  grep -qx 'CHANGELOG.md' <<<"$stageade" || stoppa \
    "CHANGELOG.md saknar post för $ver (SEO_REGLER §11 A)." \
    "Skriv posten överst i filen, för hand, och stagea den."

  # Två fällor, bägge påträffade när grinden provkördes mot sig själv:
  #
  # 1. Ankaret måste stå sist i uttrycket. `$` inuti en grupp, `(…|$)`, tolkas
  #    inte som radslut av grep -E utan får hela alternativet att falla.
  # 2. Läs filen till en variabel, pipa den inte till `grep -q`. Grep avslutar
  #    vid första träffen, `git show` dör då av SIGPIPE (141), och med
  #    `set -o pipefail` blir pipelinens status 141 — alltså "misslyckad"
  #    just när rubriken FANNS. Felet slår bara till i lyckat fall och är
  #    därför osynligt i alla negativa test.
  changelog=$(git show :CHANGELOG.md)
  grep -qE "^## +${ver//./\\.}([[:space:]].*)?$" <<<"$changelog" || stoppa \
    "CHANGELOG.md har ingen rubrik '## $ver' (SEO_REGLER §11 A)." \
    "VERSION säger $ver — posten överst måste bära samma nummer."
fi

# --- Versionssynk (SEO_REGLER §11 A och §11 C) ------------------------------
# Versionen står på tre ställen som måste vara identiska: VERSION,
# cachebustern i index.html och APP_VERSION i js/app.js. Missas den sista
# visar sajten en gammal version i all evighet och ingen omladdning hjälper,
# eftersom den app.js som serveras genuint bär det gamla numret. Hände i
# 0.9.237–0.9.240 (fyra släpp).
# Kontrollen omfattar även ?v= för ÄNDRADE js/css-filer, och utlöses därför av
# att någon av dem är stagead: en ny js-modul eller en CSS-ändring utan bumpad
# buster serveras från cache hos återvändande besökare.
if grep -qE '^(VERSION|index\.html|js/.*\.js|css/.*\.css)$' <<<"$stageade"; then
  if ! python3 scripts/bump_version.py --check; then
    stoppa "versionerna är inte i synk." \
      "Kör: python3 scripts/bump_version.py <version>"
  fi
fi

# --- Hela wire-kedjan körd, inte delar av den (SEO_REGLER §11 A) -----------
# Sidgeneratorerna skriver REN HTML; tooltips, referenser, identitet, ämne,
# sidfot, latin och datum läggs på av wire-stegen EFTERÅT. Körs bara en del av
# kedjan blir resultatet giltig HTML som saknar något — och ingenting syns.
# Det hände i 0.9.437: `generate_glossary.py` kördes ensam för att uppdatera
# <lastmod>, och ordlistans 33 sidor plus medicinskordlista.html tappade
# `author`- och `publisher`-noderna i JSON-LD:n. Sajtens starkaste E-E-A-T-
# signal, borta från 34 sidor, utan ett larm någonstans.
#
# Grinden mäter mot HELA sajten, inte mot de stageade filerna (§0.1 i
# CLAUDE_REGLER): ett wire-steg som inte kördes har oftast rört fler sidor än
# de som råkade hamna i commiten, och en kontroll som bara tittar på diffen är
# per definition blind för dem.
#
# OBS: stegen läser arbetskopian, inte indexet — precis som versionssynken
# ovan. En commit med `git add -p` och orörda ändringar kvar i trädet mäts
# alltså mot trädet. Det är rätt avvägning här: felet grinden finns för uppstår
# av en ofullständig KÖRNING, och en körning träffar hela trädet.
#
# Listan över wire-steg läses ur scripts/kedjan.py, den skrivs inte av här.
# Fram till 0.9.441 stod de åtta stegen uppräknade i den här filen — en andra
# upplaga av kedjan, exakt den sortens avskrift 0.9.438 tog bort ur SEO_REGLER.
# När wire_faq.py tillkom hade den glömts här utan att något sa till.
if grep -qE '\.html$' <<<"$stageade"; then
  echo "🔍 Kontrollerar att hela wire-kedjan körts…"
  wire_steg=$(python3 -c "import sys; sys.path.insert(0, 'scripts'); from kedjan import KEDJA; print(' '.join(dict.fromkeys(c[0].split('/')[-1][:-3] for c in KEDJA if c[0].split('/')[-1].startswith('wire_'))))") \
    || stoppa "kunde inte läsa wire-stegen ur scripts/kedjan.py."
  [ -n "$wire_steg" ] || stoppa "scripts/kedjan.py innehåller inga wire-steg — urvalet är trasigt."
  for steg in $wire_steg; do
    if ! ut=$(python3 "scripts/$steg.py" --check --all 2>&1); then
      echo "$ut"
      stoppa "scripts/$steg.py --check --all larmar (SEO_REGLER §11 A)." \
        "Ett steg i kedjan har inte körts på sidorna." \
        "Kör HELA kedjan — aldrig det enskilda steget:" \
        "  python3 scripts/kedjan.py"
    fi
  done
fi

staged=$(grep -E '^data/.*\.json$' <<<"$stageade" || true)
[ -z "$staged" ] && exit 0

echo "🔍 Quiz-regelkontroll av stageade datafiler…"
if ! python3 scripts/validate_quiz.py $staged; then
  stoppa "åtgärda FELen ovan."
fi
